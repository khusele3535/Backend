datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  price       Int
  author      String?  
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}
